GROQ_API_KEY=

# Sarvam AI - Module 2 (speech-to-text). https://dashboard.sarvam.ai
SARVAM_AI_API_KEY=

# Pinecone - Module 5 (vector store). https://app.pinecone.io
PINECONE_API_KEY=
